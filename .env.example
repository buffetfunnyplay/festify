# URL pública onde a visão do convidado está hospedada (ex.: Vercel/Netlify).
# Obrigatório quando o painel roda empacotado como APK (Capacitor), pois lá
# o "origin" é capacitor://localhost e o link copiado precisa apontar para a web.
VITE_PUBLIC_URL=https://festify.app/

# Backend opcional — preencha para trocar o localStorage pelo Supabase.
# Veja supabase/schema.sql e src/services/supabaseAdapter.js
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
